server {
    listen 80;
    listen [::]:80;
    server_name {{.ServerNames}};
    root {{.Root}};
    index index.php index.html;
{{.PageInjectConf}}{{if .FrameworkNginx}}
{{.FrameworkNginx}}
{{end}}{{range .Proxies}}{{$proxy := .}}{{range .Paths}}
    location ~ ^{{.}}(/|$) {
        set $proxybackend "{{if $proxy.OnHost}}{{$.UpstreamHost}}{{else}}{{$.FPMContainer}}{{end}}";
        proxy_pass http://$proxybackend:{{$proxy.Port}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout {{$.RequestTimeout}}s;
        proxy_send_timeout {{$.RequestTimeout}}s;
    }
{{end}}{{end}}{{.DevServerConf}}
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ {{if .FrontController}}^/index\.php(/|$){{else}}\.php${{end}} {
        set $fpm "{{.FPMContainer}}";
        fastcgi_pass $fpm:{{.FPMPort}};
        fastcgi_index index.php;
        fastcgi_connect_timeout 5s;
        fastcgi_read_timeout {{.RequestTimeout}}s;
        fastcgi_send_timeout {{.RequestTimeout}}s;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        include fastcgi_params;
{{if .FrontController}}        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_param PATH_INFO $fastcgi_path_info;
{{end}}        fastcgi_param HTTP_HOST $real_forwarded_host;
        fastcgi_param SERVER_NAME $real_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_HOST $real_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PROTO $real_forwarded_proto;
        fastcgi_param HTTP_X_FORWARDED_PORT $real_forwarded_port;
        fastcgi_param HTTP_X_REAL_IP $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param LERD_NGINX_SENT $msec;
        fastcgi_param HTTP_COOKIE "$http_cookie; SPX_KEY=$spx_key{{if .Profiling}}; SPX_ENABLED=1{{end}}";
{{if .LerdSite}}        fastcgi_param LERD_SITE {{.LerdSite}};
{{end}}{{if .LerdBranch}}        fastcgi_param LERD_BRANCH {{.LerdBranch}};
{{end}}{{.FrameworkFastCGI}}        include /etc/nginx/custom.d/{{.Domain}}.location.conf*;
    }

{{if .FrontController}}    location ~ \.php$ {
        rewrite ^ /index.php last;
    }

{{end}}    location ~ /\.ht {
        deny all;
    }

    include /etc/nginx/custom.d/{{.Domain}}.conf*;
}
